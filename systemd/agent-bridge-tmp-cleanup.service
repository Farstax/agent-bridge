[Unit]
Description=Agent-bridge temporary artifact cleanup (bridge-out, uploads, antigravity logs, legacy advisor sockets, test fixtures, merged worktrees)

[Service]
Type=oneshot
User=BRIDGE_USER
EnvironmentFile=-/etc/default/agent-bridge-shared
EnvironmentFile=/etc/default/agent-bridge-release
EnvironmentFile=-/etc/default/agent-bridge-outward-capacity
EnvironmentFile=-/etc/default/agent-bridge-interactive
ExecStart=/usr/bin/env bash -lc 'set -euo pipefail; [[ -L "${BRIDGE_CURRENT_RELEASE_DIR:?}" ]] || { echo "active release pointer is not a symlink" >&2; exit 78; }; release="$(/usr/bin/realpath -e "${BRIDGE_CURRENT_RELEASE_DIR:?}")"; [[ -f "$release/scripts/reap-tmp-artifacts.sh" && ! -L "$release/scripts/reap-tmp-artifacts.sh" ]] || { echo "cleanup executable is missing from active release" >&2; exit 78; }; if [[ -e /etc/default/agent-bridge-interactive || -e /etc/default/agent-bridge-outward-capacity ]]; then export REAP_REQUIRE_INTERACTIVE_DB=1; fi; exec /usr/bin/env bash "$release/scripts/reap-tmp-artifacts.sh"'
