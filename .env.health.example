# Health monitoring. Standalone owns its own Telegram bot; integrated shares the
# interactive bot, whose poller owns /health and command registration.
HEALTH_BOT_MODE=standalone

# Required only when HEALTH_BOT_MODE=standalone. In integrated mode set
# TELEGRAM_BOT_TOKEN_INTERACTIVE in the interactive service defaults instead.
TELEGRAM_BOT_TOKEN_HEALTH=your-health-bot-token

# Health investigations use the normal Agent Bridge provider/runtime settings.
# Optionally lock the standalone health service to one provider. If unset, the
# standalone health service defaults to Claude.
BRIDGE_PROVIDER_LOCK=claude
# Configure the selected provider with its normal settings, for example:
# CLAUDE_COMMAND=claude
# CLAUDE_MODEL_PREFERENCE=claude-sonnet-5,claude-opus-5,claude-opus-4-8,claude-haiku-4-5,claude-fable-5
# CLAUDE_EXECUTION_MODE=safe

# Standard provider effort settings apply to ordinary Runs.
CODEX_EFFORT=medium
CLAUDE_EFFORT=medium
ANTIGRAVITY_EFFORT=medium

# Telegram chat to send reports to (must be accessible by the health bot)
HEALTH_MONITOR_CHAT_ID=

# Monitoring behaviour
HEALTH_MONITOR_ENABLED=true
HEALTH_MONITOR_CADENCE_SECONDS=3600

# Storage (separate from bridge bot DBs)
HEALTH_DB_PATH=/home/content-crawler/runtime/agent-bridge/health/health.sqlite

# Optional external plugins
HEALTH_CONTENT_CRAWLER_ENABLED=0
HEALTH_CONTENT_CRAWLER_SCRIPT=

# Server monitor configuration (CPU load thresholds as multipliers of CPU count)
# HEALTH_CPU_LOAD_AMBER_MULTIPLIER=1.0
# HEALTH_CPU_LOAD_RED_MULTIPLIER=1.5
# Or set absolute thresholds:
# HEALTH_CPU_LOAD_AMBER_THRESHOLD=4.0
# HEALTH_CPU_LOAD_RED_THRESHOLD=6.0

# Swap usage warning thresholds (percentage)
# HEALTH_SWAP_MONITOR_ENABLED=true
# HEALTH_SWAP_AMBER_PCT=80
# HEALTH_SWAP_RED_PCT=95
