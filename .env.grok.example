# Grok Build ACP provider. Authenticate the runtime user (~/.grok/auth.json cached_token)
# or configure XAI_API_KEY. A non-empty key is not proof: Agent Bridge verifies it with a
# bounded isolated ACP turn. Qualification is optional diagnostic evidence; current hard
# failures suppress routing. Credentials stay workspace-local.
# GROK_ACP_COMMAND=
# GROK_ACP_ARGS=
# XAI_API_KEY=
GROK_MODEL_PREFERENCE=grok-4.6,grok-4.5
# GROK_PROJECT_DIR=
# GROK_EXECUTION_MODE=safe
# TELEGRAM_BOT_TOKEN_GROK=
