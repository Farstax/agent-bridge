# Slack Interactive Bot — one allowlisted Slack app over outbound-only Socket Mode.
# Copy to .env.slack-interactive. See docs/slack.md.

# Bot token (xoxb-...) and app-level token (xapp-..., connections:write).
# Set exactly ONE of each pair. Files are preferred: any secret manager can mount
# them, trailing newlines are trimmed, and the value is never logged.
SLACK_BOT_TOKEN_FILE=
SLACK_APP_TOKEN_FILE=
# SLACK_BOT_TOKEN=
# SLACK_APP_TOKEN=

# Required, default deny: comma-separated Slack member IDs (U0123ABCD) allowed to use the bot.
SLACK_ALLOWED_USER_IDS=

# Optional process-local readiness file (JSON schema v1, mode 0600). See docs/slack.md.
# SLACK_STATUS_FILE=/run/agent-bridge/slack-status.json

# Repository/workspace used by all providers.
# BRIDGE_PROJECT_DIR=/absolute/path/to/your/repository

# Fallback sequence for the provider chain.
INTERACTIVE_CLI_CHAIN=codex,claude,antigravity,grok,cursor

# SQLite path for sessions, queue and receipts. Use a database dedicated to Slack.
# DB_PATH=

# "safe" or "trusted" mode.
BRIDGE_EXECUTION_MODE=safe

# Busy-message admission: augment (default), interrupt the active turn, or queue.
BRIDGE_BUSY_MESSAGE_MODE=augment
