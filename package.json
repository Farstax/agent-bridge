{
  "name": "agent-bridge",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "agentBridge": {
    "hostComponents": [
      {
        "id": "voice-stt",
        "installer": "scripts/install-voice-stt.sh"
      }
    ]
  },
  "scripts": {
    "start": "tsx src/index-interactive.ts",
    "setup": "tsx src/setupCli.ts",
    "build": "tsc",
    "test": "vitest run",
    "test:resources": "vitest run --detect-async-leaks",
    "doctor": "tsx src/doctorCli.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "typecheck:unused": "tsc --noEmit -p tsconfig.unused.json",
    "cleanup:check": "knip",
    "skills": "tsx scripts/skill-manager.ts",
    "qualify:local": "bash scripts/qualify-local.sh",
    "qualify:provider": "tsx scripts/provider-qualification.ts",
    "scan-token-savings": "tsx scripts/scan-token-savings.ts"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "0.76.0",
    "@agentclientprotocol/codex-acp": "1.10.0",
    "@agentclientprotocol/sdk": "1.4.0",
    "better-sqlite3": "^12.9.0",
    "dotenv": "^17.2.3",
    "tsx": "^4.21.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "knip": "^6.27.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.9"
  }
}
