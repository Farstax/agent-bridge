TELEGRAM_BOT_TOKEN_CLAUDE=your-token

# Claude execution is release-locked to the managed claude-acp Registry adapter.
# CLAUDE_ACP_COMMAND=
# CLAUDE_ACP_ARGS=
# Optional headless API-key auth is verified with a bounded turn through that same ACP runtime.
# ANTHROPIC_API_KEY=
# Optional preference policy only. Values must be opaque model options advertised by
# the live ACP session; unadvertised values are ignored. Omit to use the provider default.
# CLAUDE_MODEL_PREFERENCE=sonnet,opus,haiku
# Optional preferred ACP thought_level value. Omit to use the provider default.
# CLAUDE_EFFORT=medium
CLAUDE_PROJECT_DIR=
# Per-bot timeout overrides (disabled by default; set positive values explicitly)
# CLAUDE_CLI_TIMEOUT_MS=0
# CLAUDE_CLI_IDLE_TIMEOUT_MS=0
DB_PATH=.data-claude/bridge.sqlite