TELEGRAM_BOT_TOKEN_ANTIGRAVITY=123456:replace-me

# Agy ACP server. Official Registry lock is antigravity-acp@1.1.1.
# The binary is not bundled; point this at the installed agy_acp_server.par.
# AGY_ACP_COMMAND=
# ANTIGRAVITY_ACP_COMMAND=
# AGY_ACP_ARGS=
# ANTIGRAVITY_ACP_ARGS=
# Authenticate with workspace-local oauth-personal credentials under
# ~/.gemini/antigravity-acp/. Do not move credentials into Agent Bridge.
# Model/effort preferences are consumed after the ACP session advertises options.
# ANTIGRAVITY_MODEL_PREFERENCE=gemini-3.8-flash,gemini-3.1-pro
# ANTIGRAVITY_EFFORT=medium
ANTIGRAVITY_PROJECT_DIR=
# Per-bot timeout overrides (disabled by default; set positive values explicitly).
# ANTIGRAVITY_CLI_TIMEOUT_MS=0
# ANTIGRAVITY_CLI_IDLE_TIMEOUT_MS=0
DB_PATH=.data-antigravity/bridge.sqlite
