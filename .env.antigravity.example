TELEGRAM_BOT_TOKEN_ANTIGRAVITY=123456:replace-me

ANTIGRAVITY_COMMAND=agy
# Optional direct Gemini API auth. Agent Bridge scopes modelProvider=gemini to API-key runs and restores it afterward.
# GEMINI_API_KEY=
ANTIGRAVITY_MODEL_PREFERENCE=gemini-3.7-flash-high,gemini-3.7-flash-medium,gemini-3.7-flash-low,gemini-3.6-flash-high,gemini-3.6-flash-medium,gemini-3.6-flash-low,gemini-3.5-flash-high,gemini-3.5-flash-medium,gemini-3.5-flash-low,gemini-3.1-pro-high,gemini-3.1-pro-low,claude-sonnet-4-6,claude-opus-4-6-thinking
# Typed stream mode. Requires Agy 1.1.8 or newer. Use json or text for rollback.
ANTIGRAVITY_OUTPUT_MODE=stream-json
# Stored/displayed for parity only; Agy has no separate effort CLI flag.
ANTIGRAVITY_EFFORT=medium
ANTIGRAVITY_PROJECT_DIR=
# Per-bot timeout overrides (disabled by default; set positive values explicitly)
# ANTIGRAVITY_CLI_TIMEOUT_MS=0
# ANTIGRAVITY_CLI_IDLE_TIMEOUT_MS=0
DB_PATH=.data-antigravity/bridge.sqlite
