# AppArmor profile for the bubblewrap helper that Codex bundles (Ubuntu 24.04+).
#
# Ubuntu 24.04 sets kernel.apparmor_restrict_unprivileged_userns=1. An unconfined
# program that creates a user namespace is moved into the "unprivileged_userns"
# profile, which denies every capability. Codex's sandbox runs commands through its
# bundled bwrap, and bwrap then fails with
#   bwrap: loopback: Failed RTM_NEWADDR: Operation not permitted
# so Codex cannot start a sandboxed command and asks to run it unsandboxed.
#
# This profile lets only that one executable create a user namespace. It confines
# nothing else (flags=(unconfined)) and leaves the sysctl at its default. The
# sandboxed commands that bwrap starts are still isolated by bwrap itself.
#
# Install (root) and load:
#   install -m 0644 agent-bridge-codex-bwrap /etc/apparmor.d/agent-bridge-codex-bwrap
#   apparmor_parser -r /etc/apparmor.d/agent-bridge-codex-bwrap
# Remove:
#   apparmor_parser -R /etc/apparmor.d/agent-bridge-codex-bwrap && rm /etc/apparmor.d/agent-bridge-codex-bwrap
#
# The Agent Bridge release path is matched with a glob so a new release needs no edit.

abi <abi/4.0>,
include <tunables/global>

profile agent-bridge-codex-bwrap /opt/agent-bridge/releases/*/node_modules/@openai/codex-linux-x64/vendor/*/codex-resources/bwrap flags=(unconfined) {
  userns,

  include if exists <local/agent-bridge-codex-bwrap>
}
