TELEGRAM_BOT_TOKEN_CODEX=123456:replace-me

# Codex runs through the managed ACP adapter.
# The pinned adapter ships at $BRIDGE_CURRENT_RELEASE_DIR/node_modules/.bin/codex-acp.
# CODEX_ACP_COMMAND=
# CODEX_ACP_ARGS=
# Optional headless auth. Agent Bridge uses CODEX_API_KEY for the managed ACP adapter
# (`DEFAULT_AUTH_REQUEST={"methodId":"api-key"}` is set for ACP).
# CODEX_API_KEY=
# Optional preference policy only. Values must be opaque model options advertised by
# the live ACP session; unadvertised values are ignored. Omit to use the provider default.
# CODEX_MODEL_PREFERENCE=<opaque-model-value>,<opaque-model-value>
# Optional preferred ACP thought_level value. Omit to use the provider default.
# CODEX_EFFORT=medium
CODEX_PROJECT_DIR=
# Per-bot timeout overrides (disabled by default; set positive values explicitly)
# CODEX_CLI_TIMEOUT_MS=0
# CODEX_CLI_IDLE_TIMEOUT_MS=0
DB_PATH=.data-codex/bridge.sqlite