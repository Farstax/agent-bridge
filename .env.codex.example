TELEGRAM_BOT_TOKEN_CODEX=123456:replace-me

CODEX_COMMAND=codex
# Codex runs through the managed ACP adapter.
# The pinned adapter ships in the release at $BRIDGE_PROJECT_DIR/node_modules/.bin/codex-acp.
# CODEX_ACP_COMMAND=
# CODEX_ACP_ARGS=
# Optional headless auth. Agent Bridge uses CODEX_API_KEY for the managed ACP adapter
# and Codex ACP (`DEFAULT_AUTH_REQUEST={"methodId":"api-key"}` is set for ACP).
# CODEX_API_KEY=
CODEX_MODEL_PREFERENCE=gpt-5.6-luna,gpt-5.6-sol,gpt-5.6-terra,gpt-5.5,gpt-5.4,gpt-5.4-mini
CODEX_EFFORT=medium
CODEX_PROJECT_DIR=
# Per-bot timeout overrides (disabled by default; set positive values explicitly)
# CODEX_CLI_TIMEOUT_MS=0
# CODEX_CLI_IDLE_TIMEOUT_MS=0
DB_PATH=.data-codex/bridge.sqlite
