#!/usr/bin/env bash
set -euo pipefail

# Run the review helper from the release that contains this script, not from a
# caller-selected directory.
RELEASE_DIR="$(realpath -e "$(dirname "$(realpath -e "${BASH_SOURCE[0]}")")/..")"
export BRIDGE_CURRENT_RELEASE_DIR="$RELEASE_DIR"
exec node "$RELEASE_DIR/dist/acpReview.js" "$@"
