# Cursor CLI provider. Authenticate the runtime user with cursor-agent login or set CURSOR_API_KEY.
# Account auth is checked via cursor-agent status --format json. API keys are verified with a bounded isolated headless turn.
# Cursor is a default fallback target only when its selected auth method is usable;
# current deterministic qualification failures still suppress routing.
# Platform onboarding remains provider-owned; Agent Bridge does not store Cursor credentials or API keys.
CURSOR_COMMAND=cursor-agent
# CURSOR_API_KEY=
# CURSOR_MODEL_PREFERENCE=composer-2.5,auto
# CURSOR_EXECUTION_MODE=safe
# TELEGRAM_BOT_TOKEN_CURSOR=
