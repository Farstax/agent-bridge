# Cursor CLI provider (opt-in). Authenticate the runtime user with cursor-agent login
# before selecting Cursor. Auth readiness is checked via: cursor-agent status --format json
# Keep Cursor out of the default interactive chain until an explicit policy change.
# Platform onboarding remains provider-owned; Agent Bridge does not store Cursor credentials.
CURSOR_COMMAND=cursor-agent
# CURSOR_MODEL_PREFERENCE=composer-2.5,auto
# CURSOR_EXECUTION_MODE=safe
# TELEGRAM_BOT_TOKEN_CURSOR=
